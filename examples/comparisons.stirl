Begin Function main()

    age = 20
    active = true

    # Using readable keywords: greaterThan, equalTo, and
    if age greaterThan 18 and active equalTo true
        print("Access Granted: User is adult and active")
    else
        print("Access Denied")
    end if

    # Using readable operator: isNot
    status = "pending"
    if status isNot "active"
        print("Notice: Account is not yet active")
    end if

    # Using symbolic operators: <, ==, ||
    score = 45
    if score < 50 or active == false
        print("Status: Review needed")
    end if

End Function
